# Copy to server/.env (or export in your host) and change these before deploying.

# Admin password for /admin (plain text — hashed automatically on boot).
ADMIN_PASSWORD=ranz-admin

# Alternatively provide a pre-computed bcrypt hash instead of the plain password:
# ADMIN_PASSWORD_HASH=$2a$10$....

# Secret used to sign admin login sessions. Use a long random string.
JWT_SECRET=please-change-this-to-a-long-random-string

# Port the server listens on (default 3001).
PORT=3001

# Set to production when deploying (enables secure cookies).
NODE_ENV=development
